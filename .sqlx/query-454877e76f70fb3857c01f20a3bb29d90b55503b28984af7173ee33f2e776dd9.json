  "query": "select t.id, t.title, t.body, t.status::text as \"status!\", t.urgency, b.slug as \"bot?\", t.act_now\n           from ticket t left join bot b on b.id = t.bot_id\n           order by t.status = 'done', array_position(array['now', 'hour', 'today', 'whenever'], t.urgency), t.id desc",
