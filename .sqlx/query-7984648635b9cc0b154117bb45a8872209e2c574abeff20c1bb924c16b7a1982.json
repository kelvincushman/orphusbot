  "query": "select id, name, mime, size, sha256, tags, description, pinned_for, source, created_at\n         from gallery_item\n         where $1 = '' or lower(name) like '%' || $1 || '%' or lower(description) like '%' || $1 || '%'\n               or $1 = any(tags)\n         order by created_at desc limit 500",
