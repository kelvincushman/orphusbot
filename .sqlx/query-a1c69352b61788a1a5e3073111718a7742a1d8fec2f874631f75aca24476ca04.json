  "query": "insert into artifact (bot_id, run_id, name, version, content)\n           select t.bot_id, $2, $3,\n                  coalesce((select max(version) from artifact a where a.bot_id = t.bot_id and a.name = $3), 0) + 1, $4\n           from thread t where t.id = $1\n           returning id, version",
