{
  "db_name": "PostgreSQL",
  "query": "select n.mission_id, n.bot, n.text, to_char(n.created_at, 'DD Mon HH24:MI') as at\n             from note n join mission m on m.id = n.mission_id\n             where n.id = $1 and (not m.private or $2 = 'orchestrator'\n                                  or $2 = 'chief--' || m.id or $2 = any(m.team))",
