{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OrphusBot",
  "version": "0.1.0",
  "identifier": "io.github.kelvincushman.orphusbot",
  "build": {
    "frontendDist": "setup"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "category": "Productivity",
    "shortDescription": "Bots that work on your tasks, on your own machines",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
