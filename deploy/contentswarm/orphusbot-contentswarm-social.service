[Unit]
Description=ContentSwarm social worker for OrphusBot (drafts into the review queue)
After=orphusbot-contentswarm.service

[Service]
Type=oneshot
WorkingDirectory=%h/orphusbot-contentswarm
EnvironmentFile=%h/.config/orphusbot/contentswarm.env
ExecStart=%h/orphusbot-contentswarm/.venv/bin/python social_worker.py
TimeoutStartSec=600
UMask=0077
