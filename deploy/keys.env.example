# API keys for the tools bots use, kept apart from node.env.
# Copy to ~/.config/orphusbot/keys.env on the node, chmod 600, fill in, and
# restart orphusbot-node. Never commit the real file.
#
# The node hands each key only to the engines of bots allowed that tool; keys
# never go into a bot's computer.

# kie.ai: images (Nano Banana 2, GPT Image 2) and video (Seedance 2) for bots
# with "Media generation" on. https://kie.ai/api-key
ORPHUSBOT_KIE_KEY=
