.kotlin/

# Gradle build output — android/build/ and android/app/build/.
#
# This was missing, and 1,005 generated files (756 MB, including a compiled
# libapp.so) were committed before anyone noticed. The rules that look like
# they should have caught it do not: app/.gitignore's `/build/` is anchored to
# the Flutter project root, so it only ever covered app/build/, and the root
# .gitignore's `app/build/` is the same path. Nothing covered the Gradle tree.
#
# No leading slash, so this matches at any depth below android/ — both
# android/build/ and android/app/build/.
build/
