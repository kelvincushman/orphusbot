source "Kconfig.zephyr"

menu "KelvinLee Features Configuration"

config KELVINLEE_CODEC_OPUS
    bool "Opus Audio Codec"
    help
        "Enable the Opus audio codec support."
    default n

config KELVINLEE_ENABLE_OFFLINE_STORAGE
	bool "Offline SD Card Storage"
    help
        "Enable the offline storage support. Requires a SD Card."
	default n

config KELVINLEE_ENABLE_ACCELEROMETER
    bool "Accelerometer Support"
    help
        "Enable the accelerometer support."
    default n

config KELVINLEE_ENABLE_BUTTON
    bool "Button support"
    help
        "Enable the software button support."
    default n

config KELVINLEE_ENABLE_SPEAKER
    bool "Enable the speaker"
    help
        "Enable the speaker support."
    default n

config KELVINLEE_ENABLE_BATTERY
    bool "Enable the battery"
    help
        "Enable the battery support."
    default n

config KELVINLEE_ENABLE_USB
    bool "Enable the usb"
    help
        "Enable the USB power check support."
    default n

config KELVINLEE_ENABLE_HAPTIC
    bool "Enable the haptic"
    help
        "Enable the haptic support."
    default n

config KELVINLEE_ENABLE_RFSW_CTRL
    bool "Enable RFSwitch Control"
    help
        "Enable RFSwitch Control support."
    default y

endmenu
